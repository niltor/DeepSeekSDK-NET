<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Authors>NilTor,AterDev</Authors>
        <Company>Geethin</Company>
        <Description>DeepSeek API SDK for ASP.NET Core with Microsoft.Extensions.AI integration</Description>
        <PackageReleaseNotes>
            1. Added multimodal vision support for deepseek-v4-flash-vision-exp, including image URLs, inline data, and Files API references.
            2. Added Files API upload, list, retrieve, and delete operations with filtering and expiration options.
            3. Added Microsoft.Extensions.AI image and file content mapping for Chat Completions and Responses API adapters.
            4. Added serialization, HTTP contract, live API coverage, and bilingual documentation for vision and Files API features.
        </PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/niltor/DeepSeekSDK-NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/niltor/DeepSeekSDK-NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>LLM,AI,DeepSeek,API,SDK,AspNetCore,Microsoft.Extensions.AI</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageIcon>logo.jpg</PackageIcon>
        <Version>1.6.0</Version>
        <PackageId>Ater.DeepSeek.AspNetCore</PackageId>
        <Title>DeepSeek.AspNetCore</Title>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright />
        <OutputType>Library</OutputType>
        <NoWarn>1701;1702;1591;1570</NoWarn>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageOutputPath>./pack</PackageOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DeepSeek.Core\DeepSeek.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\logo.jpg">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\README_cn.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
</Project>
